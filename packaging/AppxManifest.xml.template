<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the Microsoft Store (MSIX) package manifest.
  build_msix.ps1 fills in the {{TOKEN}} placeholders from
  packaging/msix_identity.json and writes the result into the build
  staging directory. This file itself is never used directly.

  This packages Neight.exe as a classic Win32 app under the Desktop
  Bridge (EntryPoint="Windows.FullTrustApplication"), not as a native
  UWP app. No source code changes needed.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{PACKAGE_IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{PACKAGE_VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{APP_DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Neight" Executable="Neight.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{APP_DISPLAY_NAME}}"
        Description="A lightweight text editor for writers who work in Tamil and English."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <!--
        File type associations.

        For a packaged app this manifest is the *only* mechanism the shell
        honours. Writing HKCU\Software\Classes from inside the app does not
        work: those writes do not survive, and the open command would point at
        C:\Program Files\WindowsApps\<name>_<version>_..., a path that ceases
        to exist at the next Store update.

        Declaring a type here makes Neight appear under right-click -> Open
        With. It does NOT make Neight the default handler, and nothing can:
        since Windows 8 the UserChoice value is protected by an OS-verified
        hash, so promoting Neight to default is the user's choice alone, made
        in Settings -> Default apps.

        Name must be lowercase with no dots. Each FileType keeps its leading
        dot. Logo must exist in the staging tree -- build_msix.ps1 stages
        packaging/msix_assets/Assets/.
      -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="neighttext">
            <uap:DisplayName>Plain Text Document</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.txt</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="neightmarkdown">
            <uap:DisplayName>Markdown Document</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
